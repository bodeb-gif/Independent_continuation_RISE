extract_claims:
  [ok] finds future-marker sentence near phrase
  [ok] drops ad/junk sentences
  [ok] drops too-short and too-long sentences
  [ok] ignores retrospective sentence without future marker
search_pages pagination:
  'business slump': 14 total pages, taking up to 30
  [ok] stops at reported total instead of paging past the end (the 404 bug)
  'recession': 50 total pages, taking up to 30
  [ok] respects max_pages cap when results exceed it
  [ok] empty result set yields nothing
fetch_full_text:
  [ok] pulls text via resource.fulltext_file
  [ok] missing fulltext_file returns empty string, not crash
scoring rules:
  [ok] prices: CPI step up -> 'up'
  [ok] prices before 1913 unscorable
  [ok] general business: INDPRO crash -> 'worsen'
  [ok] pre-1919 falls back to NBER; May 1908 in recession -> 'worsen'
  [ok] NBER: Oct 1908 after trough -> 'improve'
  [ok] predicted_label maps employment 'improve' to unemployment 'down'
  [ok] predicted_label passes general direction through
heuristic grading:
  [ok] optimistic keywords -> improve
  [ok] pessimistic keywords -> worsen
  [ok] no signal -> not a prediction
tier2 geography:
  [ok] all four census regions present
  [ok] covers 50 states + DC
  [ok] sample mappings correct
  [ok] financial centers are a subset of known states
cohens_kappa:
  [ok] perfect agreement -> 1.0
  [ok] random labels -> kappa near 0
disagreement:
  [ok] episode_disagreement_rate: 3 improve/2 worsen -> minority share 0.4
  [ok] first claim in episode (no prior claims) imputed to episode rate
  [ok] second claim sees only claim A (improve) -> full agreement, 0.0
  [ok] no_change claim still gets a local_disagreement computed from context (A, B both improve, no worsen -> 0.0), it's just excluded from COUNTING
  [ok] claim C sees A, B (both improve) -> full agreement, 0.0
  [ok] claim D sees A, B (improve) + C (worsen) -> minority share 1/3
  [ok] claim E is >3 months after D (backward window empty) -> imputed to episode rate, not leaking from claims before the window OR the empty window silently becoming 0
  [ok] backward-only window: claim X must NOT see claim Y, which comes after it -- X has no prior claims so it's imputed to the episode rate (0.5 here), not contaminated by Y's later, opposite-direction claim
  [ok] claim Y correctly sees X (the one claim strictly before it, improve) -> full agreement, 0.0
hedging_lexicon:
  [ok] hedging_features: hedge-heavy sentence classed 'hedged'
  [ok] hedging_features: counts multiple hedge terms (may, perhaps, seems, uncertain)
  [ok] hedging_features: booster-heavy sentence classed 'assertive'
  [ok] hedging_features: assertive sentence has negative hedge_score
  [ok] hedging_features: no markers -> neutral, zero score
naive_skill (baseline-relative scoring):
  [ok] always-improve forecaster gets hit rate == naive baseline
  [ok] ...and therefore exactly zero skill
  [ok] counts only directional rows
  [ok] perfect forecaster shows positive skill
  [ok] excludes up/down/stable price-direction rows
  [ok] empty input returns n=0 without raising
greenbook_analysis:
  [ok] NBER_MODERN: every peak precedes its trough
  [ok] NBER_MODERN: recessions are in chronological order
  [ok] NBER_MODERN: no overlapping contractions
  [ok] NBER_MODERN: covers the Greenbook era, picking up where score_claims stops
  [ok] HORIZONS: nowcast through 8 quarters, in order
spf_benchmark:
  [ok] direction_label: strong growth -> improve
  [ok] direction_label: contraction -> worsen
  [ok] direction_label: within band -> no_change
  [ok] direction_label: NaN forecast -> empty (unscorable)
  [ok] survey_date: 1970 Q2 starts in April 1970
  [ok] score_spf: mean forecast +4 -> predicted 'improve'
  [ok] score_spf: predicted improve vs realized improve -> hit=1
  [ok] score_spf: mean forecast -1 -> predicted 'worsen', realized improve -> hit=0
